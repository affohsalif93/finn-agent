# Copy to .env and fill in. .env is git-ignored and never baked into the image.
# Placeholders only. Keys follow docs/ARCHITECTURE.md §11.

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Mailbox (Gmail, IMAP/SMTP with an app password; requires 2-step verification) ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=finn.example@gmail.com
IMAP_PASSWORD=your-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=finn.example@gmail.com
SMTP_PASSWORD=your-app-password

# --- Mail gate ---
# Finn's own address (replies are sent from it)
FINN_ADDRESS=finn.example@gmail.com
# Comma-separated sender addresses/domains, * = everyone
ALLOWED_SENDERS=*
REQUIRE_DMARC_PASS=false

# --- Paths (relative to the repo root / /app in the container) ---
CONTRACTS_DIR=material
PROFILES_DIR=data/contract_profiles
RUNS_DIR=runs

# --- Temporal ---
# localhost:7233 for `uv run finn ...` on the host; docker-compose.yml sets temporal:7233 itself
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_TASK_QUEUE=finn

# --- Langfuse tracing (optional; off when the keys are empty; EU region) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Behaviour ---
POLL_INTERVAL_SECONDS=15
LOOKBACK_DAYS=3
# Headroom below this ratio is flagged as "tight"
TIGHT_HEADROOM_RATIO=0.10
# console | json
LOG_FORMAT=console
