# Copy to .env and fill in (never commit .env).

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=

# Mailbox (IMAP/SMTP with an app password)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=finn.example@gmail.com
IMAP_PASSWORD=
IMAP_FOLDER=Finn
IMAP_PROCESSED_FOLDER=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=finn.example@gmail.com
SMTP_PASSWORD=
SMTP_FROM_NAME=Finn (Covenant-Prüfung)
# Optional transport / Sent folder settings (defaults fit Gmail; see .env.testmail.example)
IMAP_SSL=true
SMTP_SECURITY=auto
IMAP_SENT_FOLDER=
IMAP_APPEND_SENT=auto

# Mail gate (* = accept all senders)
FINN_ADDRESS=finn.example@gmail.com
ALLOWED_SENDERS=*
REQUIRE_DMARC_PASS=false

# Paths
CONTRACTS_DIR=material
PROFILES_DIR=data/contract_profiles
RUNS_DIR=runs

# Temporal (compose overrides with temporal:7233)
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_TASK_QUEUE=finn

# Behaviour
POLL_INTERVAL_SECONDS=15
LOOKBACK_DAYS=3
TIGHT_HEADROOM_RATIO=0.10
LOG_FORMAT=console
MAX_MAIL_MB=25
WAIT_FOR_INPUT_DAYS=7
REPLY_LLM_POLISH=true
