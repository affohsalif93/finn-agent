# Copy to .env and fill in (never commit .env).

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=

# Mailbox (IMAP/SMTP with an app password)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=finn.example@gmail.com
IMAP_PASSWORD=
IMAP_FOLDER=Finn
IMAP_PROCESSED_FOLDER=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=finn.example@gmail.com
SMTP_PASSWORD=
SMTP_FROM_NAME=Finn (Covenant-Prüfung)

# Mail gate (* = accept all senders)
FINN_ADDRESS=finn.example@gmail.com
ALLOWED_SENDERS=*
REQUIRE_DMARC_PASS=false

# Paths
CONTRACTS_DIR=material
PROFILES_DIR=data/contract_profiles
RUNS_DIR=runs

# Temporal (compose overrides with temporal:7233)
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_TASK_QUEUE=finn

# Langfuse (optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# Behaviour
POLL_INTERVAL_SECONDS=15
LOOKBACK_DAYS=3
TIGHT_HEADROOM_RATIO=0.10
LOG_FORMAT=console
MAX_MAIL_MB=25
WAIT_FOR_INPUT_DAYS=7
REPLY_LLM_POLISH=true

# Langfuse server (self-hosted, compose profile "observability"; generate random values)
LANGFUSE_IMAGE_TAG=4
LF_ADMIN_EMAIL=
LF_ADMIN_PASSWORD=
LF_NEXTAUTH_SECRET=
LF_SALT=
LF_ENCRYPTION_KEY=
LF_POSTGRES_PASSWORD=
LF_CLICKHOUSE_PASSWORD=
LF_REDIS_PASSWORD=
LF_MINIO_PASSWORD=
