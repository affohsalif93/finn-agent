# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Secrets – never commit API keys or mailbox credentials
.env
.env.*
!.env.example
!.env.testmail.example

# IDE
.idea/

# Agent skills (third-party copies; restore from skills-lock.json with `npx skills experimental_install`)
.claude/
.agents/

# Runtime output (runs/ contains mail content)
out/
runs/
runs-testmail/
*.log

# Plan variants: generated by scripts/make_plan_fixtures.py (tests build them in a temp dir)
tests/fixtures/plans/

# Contract onboarding cache (PDF page texts by sha256)
data/.cache/

# AWS CDK (aws/): synth output; context cache holds the account ID + pinned AMI
aws/cdk.out/
aws/cdk.context.json
