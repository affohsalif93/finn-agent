# Finn against the LOCAL test mail server (compose profile "testmail", docs/ARCHITECTURE.md §11).
# Used as is by finn-worker-testmail / finn-poller-testmail; no real secrets in here, only the
# GreenMail test passwords. Local overrides go into .env.testmail (git-ignored), which compose
# reads after this file.

# LLM: FINN_LLM_FAKE and OPENAI_API_KEY are set by compose (deterministic stand-in by default,
# llm/fake.py, TEST ONLY); `finn demo send-cases --real-llm` switches the containers to OpenAI.
OPENAI_MODEL=
REPLY_LLM_POLISH=true

# Mailbox: GreenMail, plain IMAP/SMTP (no TLS on the test ports), no SPECIAL-USE
IMAP_HOST=greenmail
IMAP_PORT=3143
IMAP_SSL=false
IMAP_USER=finn@finn.test
IMAP_PASSWORD=finn-test
IMAP_FOLDER=INBOX
IMAP_PROCESSED_FOLDER=Verarbeitet
IMAP_SENT_FOLDER=Sent
IMAP_APPEND_SENT=true
SMTP_HOST=greenmail
SMTP_PORT=3025
SMTP_SECURITY=plain
SMTP_USER=finn@finn.test
SMTP_PASSWORD=finn-test
SMTP_FROM_NAME=Finn (Covenant-Prüfung)

# Gate: the test company's domain, one denied address (reject case), no DMARC on GreenMail
FINN_ADDRESS=finn@finn.test
ALLOWED_SENDERS=@stadtwerke.test,!blocked@stadtwerke.test
REQUIRE_DMARC_PASS=false

# Paths (container view; ./runs-testmail is mounted at /app/runs)
CONTRACTS_DIR=material
PROFILES_DIR=data/contract_profiles
RUNS_DIR=runs

# Temporal: the compose stack's dev server, own task queue (compose sets both again)
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_TASK_QUEUE=finn-testmail

# Behaviour: fast polling; small size limit so the "mail too large" case stays cheap
POLL_INTERVAL_SECONDS=2
LOOKBACK_DAYS=3
MAX_MAIL_MB=2
WAIT_FOR_INPUT_DAYS=7
LOG_FORMAT=console
